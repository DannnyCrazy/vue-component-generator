    "verify:build": "node scripts/verify-build.mjs",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:meter": "node scripts/verify-meter-e2e.mjs",
    "meter:sim": "node scripts/meter-simulator.mjs"
  },
  "dependencies": {
