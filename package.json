    "vue-router": "^4.6.4",
    "vue3-sfc-loader": "^0.9.5"
  },
  "devDependencies": {
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/server-renderer": "^3.5.43",
    "codemirror": "^6.0.2",
    "playwright-core": "^1.64.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.13"
